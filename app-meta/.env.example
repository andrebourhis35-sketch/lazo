# Copia este archivo como .env (en esta misma carpeta app-meta/) y completa los valores.
# .env está en .gitignore: nunca lo subas al repositorio ni lo pegues en un chat.

# Token de acceso de la WhatsApp Cloud API (token de usuario del sistema recomendado).
WHATSAPP_ACCESS_TOKEN=

# ID de la cuenta de WhatsApp Business (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ID del número de teléfono emisor (Phone Number ID, no el número en sí).
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API, con formato vNN.N. Usa la vigente que indica el panel de tu app en Meta.
GRAPH_API_VERSION=

# Opcional. Puerto local del servidor (por defecto 3000). Solo escucha en 127.0.0.1.
PORT=3000
