[Unit]
Description=Respaldo consistente de LAZO CRM
After=lazo-crm.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/lazo-crm/current/app-crm/deploy/backup.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lazo-crm /var/backups/lazo-crm
ProtectHome=true
PrivateTmp=true
